{
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/newsletter/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/send-reminders/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/admin/newsletter/send/route.ts": {
      "maxDuration": 60
    }
  }
}
